<!-- The face's settings page in the Connect IQ app on the phone -->
<settings>
    <setting propertyKey="@Properties.TopField" title="@Strings.TopFieldTitle">
        <settingConfig type="list">
            <listEntry value="1">@Strings.FieldDate</listEntry>
            <listEntry value="2">@Strings.FieldBattery</listEntry>
            <listEntry value="3">@Strings.FieldSteps</listEntry>
            <listEntry value="4">@Strings.FieldHeartRate</listEntry>
            <listEntry value="0">@Strings.FieldNone</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.RightField" title="@Strings.RightFieldTitle">
        <settingConfig type="list">
            <listEntry value="1">@Strings.FieldDate</listEntry>
            <listEntry value="2">@Strings.FieldBattery</listEntry>
            <listEntry value="3">@Strings.FieldSteps</listEntry>
            <listEntry value="4">@Strings.FieldHeartRate</listEntry>
            <listEntry value="0">@Strings.FieldNone</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.BottomField" title="@Strings.BottomFieldTitle">
        <settingConfig type="list">
            <listEntry value="1">@Strings.FieldDate</listEntry>
            <listEntry value="2">@Strings.FieldBattery</listEntry>
            <listEntry value="3">@Strings.FieldSteps</listEntry>
            <listEntry value="4">@Strings.FieldHeartRate</listEntry>
            <listEntry value="0">@Strings.FieldNone</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.LeftField" title="@Strings.LeftFieldTitle">
        <settingConfig type="list">
            <listEntry value="1">@Strings.FieldDate</listEntry>
            <listEntry value="2">@Strings.FieldBattery</listEntry>
            <listEntry value="3">@Strings.FieldSteps</listEntry>
            <listEntry value="4">@Strings.FieldHeartRate</listEntry>
            <listEntry value="0">@Strings.FieldNone</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.Dial" title="@Strings.DialTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.DialOutlineAndMarks</listEntry>
            <listEntry value="1">@Strings.DialMarksOnly</listEntry>
            <listEntry value="3">@Strings.DialMarksAndNumbers</listEntry>
            <listEntry value="4">@Strings.DialNumbersOnly</listEntry>
            <listEntry value="2">@Strings.DialNone</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.SecondsHand" title="@Strings.SecondsTitle">
        <settingConfig type="boolean" />
    </setting>
</settings>
