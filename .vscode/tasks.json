{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & Run Simulator",
            "detail": "Builds the face for the watch you pick and shows it in the Connect IQ simulator",
            "type": "shell",
            "command": "./scripts/simulator.sh",
            "args": [
                "${command:monkeyc.getTargetDevice}",
                "${config:monkeyC.developerKeyPath}"
            ],
            "presentation": {
                "reveal": "always"
            },
            "runOptions": {
                "instancePolicy": "terminateOldest"
            },
            "problemMatcher": []
        },
        {
            "label": "Export for Connect IQ Store",
            "detail": "Builds bin/MinimalismFace.iq, the file to upload to the Connect IQ Store",
            "type": "shell",
            "command": "./scripts/export.sh",
            "args": [
                "${config:monkeyC.developerKeyPath}"
            ],
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        }
    ]
}
